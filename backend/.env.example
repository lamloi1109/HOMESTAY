# Use "local" for development or "r2" for Cloudflare R2 in production.
HOMESTAY_STORAGE_BACKEND=local
HOMESTAY_UPLOAD_DIR=uploads

# Cloudflare R2 (required when HOMESTAY_STORAGE_BACKEND=r2)
HOMESTAY_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
HOMESTAY_R2_ACCESS_KEY_ID=
HOMESTAY_R2_SECRET_ACCESS_KEY=
HOMESTAY_R2_BUCKET_NAME=homestay-images
# Public custom domain or the bucket's public r2.dev URL; no trailing slash.
HOMESTAY_R2_PUBLIC_URL=https://images.example.com
HOMESTAY_R2_KEY_PREFIX=property-images
