#!/bin/sh
# Kỷ luật commit (docs/PROMPT_EXECUTOR_FABLE5.md): "Không commit code chưa
# chạy lint + test local." Repo tách frontend/ + backend/, không có
# package.json ở gốc — bản hook trước tìm package.json ở gốc nên luôn no-op
# (xem TASKS.md T-005). Bản này lint/test đúng thư mục có file staged.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)

STAGED_APP_FILES=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -Ev '^(docs/|\.coordination/|WORKFLOW.*\.md$|README\.md$)' || true)

if [ -z "$STAGED_APP_FILES" ]; then
  # Chỉ đổi docs/coordination — không có gì để lint/test.
  exit 0
fi

FRONTEND_STAGED=$(printf '%s\n' "$STAGED_APP_FILES" | grep -E '^frontend/' || true)
BACKEND_STAGED=$(printf '%s\n' "$STAGED_APP_FILES" | grep -E '^backend/' || true)

fail=0

if [ -n "$FRONTEND_STAGED" ] && [ -f "$REPO_ROOT/frontend/package.json" ]; then
  echo "pre-commit: frontend/ có thay đổi — chạy npm run lint..."
  if ! (cd "$REPO_ROOT/frontend" && npm run lint); then
    echo "pre-commit: frontend lint FAILED." >&2
    fail=1
  fi
fi

if [ -n "$BACKEND_STAGED" ]; then
  if [ -x "$REPO_ROOT/backend/.venv/bin/ruff" ]; then
    RUFF="$REPO_ROOT/backend/.venv/bin/ruff"
    PY="$REPO_ROOT/backend/.venv/bin/python"
  elif [ -f "$REPO_ROOT/backend/.venv/Scripts/python.exe" ]; then
    RUFF="$REPO_ROOT/backend/.venv/Scripts/ruff.exe"
    PY="$REPO_ROOT/backend/.venv/Scripts/python.exe"
  elif command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
    PY="python3"
  else
    RUFF=""
  fi

  if [ -n "$RUFF" ]; then
    echo "pre-commit: backend/ có thay đổi — chạy ruff check..."
    if ! (cd "$REPO_ROOT/backend" && "$RUFF" check .); then
      echo "pre-commit: ruff FAILED." >&2
      fail=1
    fi
    echo "pre-commit: chạy pytest backend (cần Postgres tại HOMESTAY_DATABASE_URL)..."
    if ! (cd "$REPO_ROOT/backend" && "$PY" -m pytest -q); then
      echo "pre-commit: pytest FAILED." >&2
      fail=1
    fi
  else
    echo "pre-commit: backend/ có thay đổi nhưng không tìm thấy ruff (chưa tạo backend/.venv?) — BỎ QUA kiểm tra backend, tự chạy 'ruff check .' + 'pytest' tay trước khi push." >&2
  fi
fi

if [ "$fail" -eq 1 ]; then
  echo "pre-commit: có bước kiểm tra FAILED — commit bị chặn. Sửa lỗi trước khi commit (hoặc --no-verify nếu thật sự cần, phải nêu rõ lý do)." >&2
  exit 1
fi

exit 0
