#!/bin/sh
# Enforce commit message convention for this repo.
# Two accepted formats:
#   1. Phase work (per docs/PROMPT_EXECUTOR_FABLE5.md "Kỷ luật commit"):
#        [phase-N][type]: mô tả
#      ví dụ: [phase-2][feat]: booking soft-hold with FOR UPDATE
#   2. Coordination-layer housekeeping (per .coordination/AGENT_ONBOARDING.md),
#      only for pure .coordination/* claim/report commits:
#        chore(coord): ...
# Merge/revert commits generated by git are always allowed.

MSG_FILE="$1"
FIRST_LINE=$(head -n1 "$MSG_FILE")

# Allow git-generated merge/revert commits untouched.
case "$FIRST_LINE" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

PHASE_RE='^\[phase-(0|[1-9][0-9]*)(\+)?\]\[(feat|fix|test|docs|chore|refactor|perf|style|build|ci)\]: .+'
COORD_RE='^chore\(coord\): .+'

if echo "$FIRST_LINE" | grep -qE "$PHASE_RE"; then
  exit 0
fi
if echo "$FIRST_LINE" | grep -qE "$COORD_RE"; then
  exit 0
fi

echo "Commit message không đúng convention của repo này." >&2
echo "" >&2
echo "Dòng đầu hiện tại: $FIRST_LINE" >&2
echo "" >&2
echo "Dùng 1 trong 2 format:" >&2
echo "  [phase-N][type]: mô tả          (vd: [phase-2][feat]: booking soft-hold with FOR UPDATE)" >&2
echo "  chore(coord): mô tả             (chỉ cho thao tác .coordination/* — claim task, session report)" >&2
echo "" >&2
echo "type hợp lệ: feat|fix|test|docs|chore|refactor|perf|style|build|ci" >&2
echo "Xem docs/PROMPT_EXECUTOR_FABLE5.md và .coordination/DECISIONS.md (D-004)." >&2
exit 1
