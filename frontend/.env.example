# Copy thành .env.local để override. Mặc định trỏ backend dev.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Domain thật của site — BẮT BUỘC đặt đúng khi deploy.
# sitemap.xml, robots.txt, thẻ canonical và Open Graph đều dựng URL từ đây;
# để nguyên localhost khi deploy là Google sẽ index nhầm địa chỉ.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public custom domain hoặc r2.dev URL của bucket chứa static assets (Cloudflare R2 gaoji-photos).
# Khi có giá trị, request /assets/photos/* được redirect sang R2; brand assets (/assets/*.png) tiếp tục serve local.
NEXT_PUBLIC_ASSET_BASE_URL=https://pub-f4801f91b77a4269828769d0b4821905.r2.dev
