# Standalone Express service; legacy postgresql+asyncpg URLs are also accepted.
HOMESTAY_DATABASE_URL=postgresql://homestay:homestay@127.0.0.1:5432/homestay
HOMESTAY_TEST_DATABASE_URL=postgresql://homestay:homestay@127.0.0.1:5432/homestay_test
HOMESTAY_JWT_SECRET=dev-only-secret-change-in-production-0123456789
HOMESTAY_ACCESS_TOKEN_EXPIRE_MINUTES=1440
HOMESTAY_BOOKING_HOLD_MINUTES=15
HOMESTAY_MAX_BOOKING_NIGHTS=30
HOMESTAY_CORS_ORIGINS=["http://localhost:3000"]
PORT=8000

# Use "local" for development or "r2" for Cloudflare R2 in production.
HOMESTAY_STORAGE_BACKEND=local
HOMESTAY_UPLOAD_DIR=uploads

# Cloudflare R2 (required when HOMESTAY_STORAGE_BACKEND=r2)
HOMESTAY_R2_ENDPOINT_URL=https://f790018d2f2c91a4cc23370a55a5ca3b.r2.cloudflarestorage.com
HOMESTAY_R2_ACCESS_KEY_ID=
HOMESTAY_R2_SECRET_ACCESS_KEY=
HOMESTAY_R2_BUCKET_NAME=gaoji-photos
# Public custom domain or the bucket's public r2.dev URL; no trailing slash.
HOMESTAY_R2_PUBLIC_URL=https://pub-f4801f91b77a4269828769d0b4821905.r2.dev
HOMESTAY_R2_KEY_PREFIX=properties
