{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaojihouse",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "build": {
    "command": "npx --yes @opennextjs/cloudflare@1.20.9 build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gaojihouse"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "previews": {
    "images": {
      "binding": "IMAGES"
    }
  },
  "observability": {
    "enabled": true
  }
}
