{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/nav/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Condensed|EB Garamond|Great Vibes|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Barlow Condensed, EB Garamond, Great Vibes, Newsreader."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:jade|gold|clay|paper|outline|available|held)$/]",
        "message": "<Badge> tone must be one of 'jade' | 'gold' | 'clay' | 'paper' | 'outline' | 'available' | 'held'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|full|disabled|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, full, disabled, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:jade|gold|clay|outline|ghost|onDark)$/]",
        "message": "<Button> variant must be one of 'jade' | 'gold' | 'clay' | 'outline' | 'ghost' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:zalo|wechat|phone|email|onInquire|style|key|ref|className|style|children)$/]",
        "message": "<ContactRail> doesn't accept that prop. Declared props: zalo, wechat, phone, email, onInquire, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|tick|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, tick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|jade|muted|onDark)$/]",
        "message": "<Eyebrow> tone must be one of 'gold' | 'jade' | 'muted' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|eyebrow|title|children|bullets|tone|image|imageAlt|imageRatio|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: icon, eyebrow, title, children, bullets, tone, image, imageAlt, imageRatio, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|warm|jade|ink)$/]",
        "message": "<FeatureCard> tone must be one of 'paper' | 'warm' | 'jade' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<FilterTab> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|label|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, label, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|shape|size|tone|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, shape, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|jade|onDark|channel)$/]",
        "message": "<IconButton> variant must be one of 'outline' | 'jade' | 'onDark' | 'channel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|circle)$/]",
        "message": "<IconButton> shape must be one of 'square' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|hint|error|onDark|as|rows|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, icon, hint, error, onDark, as, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InquiryModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|unitTypes|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<InquiryModal> doesn't accept that prop. Declared props: open, onClose, unitTypes, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|showTagline|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, showTagline, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Logo> variant must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Logo> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoPlate'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|ratio|offset|frame|zoom|style|key|ref|className|style|children)$/]",
        "message": "<PhotoPlate> doesn't accept that prop. Declared props: src, alt, caption, ratio, offset, frame, zoom, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoPlate'] > JSXAttribute[name.name='offset'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<PhotoPlate> offset must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingStars'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|count|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<RatingStars> doesn't accept that prop. Declared props: value, count, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingStars'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<RatingStars> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomSpecs'] > JSXAttribute > JSXIdentifier[name!=/^(?:beds|baths|sqm|guests|tone|style|key|ref|className|style|children)$/]",
        "message": "<RoomSpecs> doesn't accept that prop. Declared props: beds, baths, sqm, guests, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomSpecs'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<RoomSpecs> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|aside|action|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, aside, action, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SectionHeader> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeader> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StayQueryBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:onSubmit|unitTypes|labels|style|key|ref|className|style|children)$/]",
        "message": "<StayQueryBar> doesn't accept that prop. Declared props: onSubmit, unitTypes, labels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|selected|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: icon, selected, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnitCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|title|image|type|floor|beds|baths|sqm|monthlyRateVnd|nightlyRateVnd|status|statusLabel|onView|onInquire|labels|style|key|ref|className|style|children)$/]",
        "message": "<UnitCard> doesn't accept that prop. Declared props: code, title, image, type, floor, beds, baths, sqm, monthlyRateVnd, nightlyRateVnd, status, statusLabel, onView, onInquire, labels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnitCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:available|held)$/]",
        "message": "<UnitCard> status must be one of 'available' | 'held'."
      }
    ]
  },
