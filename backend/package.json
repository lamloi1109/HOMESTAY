{
  "name": "homestay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-sql.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "validator": "13.15.35",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/validator": "13.15.10",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
